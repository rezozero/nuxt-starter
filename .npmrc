# Only needed by @events-api/javascript-sdk; defaults keep installs warning-free without it.
# `.invalid` never resolves, so the scope can't fall back to a public registry.
@events-api:registry="https://${EVENTS_API_NPM_REGISTRY_URL:-events-api.invalid/}"
//${EVENTS_API_NPM_REGISTRY_URL:-events-api.invalid/}:_authToken=${EVENTS_API_NPM_TOKEN:-unset}
