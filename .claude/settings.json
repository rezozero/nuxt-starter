{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(pnpm lint)",
            "Bash(pnpm lint:js)",
            "Bash(pnpm lint:css)",
            "Bash(pnpm test)",
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./stories/.env)"
        ]
    }
}
